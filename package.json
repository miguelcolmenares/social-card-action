{
  "name": "social-card-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that draws a 1200 by 630 social card PNG for a project, from its name and description.",
  "type": "module",
  "license": "MIT",
  "author": "Miguel Colmenares",
  "homepage": "https://github.com/miguelcolmenares/social-card-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelcolmenares/social-card-action.git"
  },
  "bugs": {
    "url": "https://github.com/miguelcolmenares/social-card-action/issues"
  },
  "keywords": [
    "github-action",
    "social-card",
    "open-graph",
    "og-image",
    "social-preview"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./src/register-alias.mjs --test \"src/__tests__/**/*.test.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
